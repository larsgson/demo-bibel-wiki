---
import BaseLayout from "../../../layouts/BaseLayout.astro"
import { regionConfigs } from "../../../lib/data/region-config"
import { displayName, altName } from "../../../lib/data/languageNames"
import { hasPkf } from "../../../lib/bw/language-list"
import { isStudyLanguage } from "../../../lib/bw/study-languages"
import { t } from "../../../lib/bw/ui-locales"
import "../../../styles/region-landing.css"

export function getStaticPaths() {
  return regionConfigs.map((rc) => ({ params: { region: rc.code }, props: { rc } }))
}

const { rc } = Astro.props
const lang = rc.uiLanguage || "en"

// The grouping that drives the browse (picker.filterBy, else the first one).
const grouping =
  rc.grouping.find((g) => g.id === rc.picker?.filterBy) ?? rc.grouping[0] ?? null

function tile(iso: string) {
  return {
    iso,
    name: displayName(iso),
    alt: altName(iso),
    pkf: hasPkf(iso),
    study: isStudyLanguage(iso),
    href: `/${iso}/`,
  }
}

// Groups with their language tiles, largest group first.
const groups = (grouping?.group ?? [])
  .map((g) => ({
    slug: g.slug,
    name: g.name[lang] ?? g.name.en,
    tiles: g.languages.map(tile),
  }))
  .sort((a, b) => b.tiles.length - a.tiles.length)

// Hero image (from the region config). Featured-template chips were removed:
// this page is a language picker, not a story browser — clicking a template
// dropped the visitor straight into a chapter reader without a language
// having been chosen, which isn't this page's job.
const heroImage = rc.landing?.heroImage

// Trade/bridge language(s) — a visible escape hatch for visitors whose own
// minority language has no resources yet. Kept out of the island/family
// tile grid entirely (it's not "one of the region's languages" in the same
// sense) and always shown, however many there are (regions can have 2-3).
const tradeLangs = rc.tradeLanguages.map(tile)

const tr = (k: string) => t(lang, `regionLanding.${k}`)

const title = rc.name[lang] ?? rc.code
---

<BaseLayout title={title} landing={true} heroCredit={rc.landing?.heroCredit}>
  <div class="region-landing" style={`--accent:${rc.landing?.accentColor ?? "#000b63"}`}>
    <section
      class={`region-hero${heroImage ? " has-image" : ""}`}
      style={heroImage ? `--hero-image:url('${heroImage}')` : ""}
    >
      <h1>{rc.landing?.headline?.[lang] ?? title}</h1>
      {rc.landing?.subhead?.[lang] && <p>{rc.landing.subhead[lang]}</p>}
    </section>

    {tradeLangs.length > 0 && (
      <section class="region-trade">
        <p class="region-trade-label">{tr("tradeLanguageIntro")}</p>
        <div class="region-trade-row">
          {tradeLangs.map((tl) => (
            <a class="region-trade-chip" href={tl.href}>
              {tl.name}
              {tl.alt && <span class="lang-tile-alt">{tl.alt}</span>}
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="region-groups">
      {groups.map((g) =>
        g.tiles.length === 1 ? (
          <a class="group-card group-card--single" href={g.tiles[0].href}>
            <span class="group-card-title">{g.name}</span>
            <span class="lang-tile-alt">{g.tiles[0].name}</span>
          </a>
        ) : (
          <details class="group-card">
            <summary>
              <span class="group-card-title">{g.name}</span>
              <span class="group-card-count">{g.tiles.length}</span>
            </summary>
            <div class="lang-tile-grid">
              {g.tiles.map((tl) => (
                <a class="lang-tile" href={tl.href}>
                  <span class="lang-tile-name">{tl.name}</span>
                  {tl.alt && <span class="lang-tile-alt">{tl.alt}</span>}
                  {(tl.pkf || tl.study) && (
                    <span class="lang-tile-badges">
                      {tl.pkf && <span title={tr("fullTextAudio")}>📖</span>}
                      {tl.study && <span class="study" title={tr("studyAvailable")}> ✦</span>}
                    </span>
                  )}
                </a>
              ))}
            </div>
          </details>
        ),
      )}
    </section>
  </div>

  <script>
    // Start a PKF language's full-Bible binary downloading as soon as the
    // visitor's pointer lands on (or taps) its tile — before navigation even
    // completes — so it's already in flight by the time the reader mounts.
    // See src/lib/reader/prefetch.ts for why this is the high-leverage spot
    // (the .pkf fetch+parse, not any catalog lookup, is what's slow).
    import { prefetchPkfText } from "../../../lib/reader/prefetch"

    function isoFromHref(href: string): string | null {
      const m = href.match(/^\/([a-z]{3})\/?$/)
      return m ? m[1] : null
    }

    document
      .querySelectorAll<HTMLAnchorElement>(".lang-tile, .group-card--single, .region-trade-chip")
      .forEach((a) => {
        const iso = isoFromHref(new URL(a.href).pathname)
        if (!iso) return
        const trigger = () => prefetchPkfText(iso)
        a.addEventListener("pointerenter", trigger, { once: true })
        a.addEventListener("pointerdown", trigger, { once: true })
      })
  </script>
</BaseLayout>
