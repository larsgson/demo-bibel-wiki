---
import BaseLayout from "../layouts/BaseLayout.astro"
import LanguageSearch from "../lib/components/LanguageSearch.svelte"
import { regions } from "../lib/data/regions"
import { regionConfigByCode } from "../lib/data/region-config"
import { displayName, altName } from "../lib/data/languageNames"
import { en as t } from "../locales/en"
import "../styles/home-landing.css"

// Cards: one per configured region (config/regions/*.toml) NOT marked
// unlisted (see RegionConfig.landing.unlisted), plus a fixed "English (BSB)"
// entry — this page is a router into those, not a second copy of what
// /r/<code>/ already does with proper island/family grouping. A region
// marked unlisted (e.g. config/regions/za.toml, still thin on content) stays
// fully reachable at /r/<code>/ and its subdomain redirect — it's just not
// promoted from here yet.
const listedRegions = regions.filter((r) => !regionConfigByCode.get(r.id)?.landing?.unlisted)

const regionCards = listedRegions.map((r) => {
  const cfg = regionConfigByCode.get(r.id)
  return {
    id: r.id,
    displayName: r.displayName,
    count: r.available.length,
    heroImage: cfg?.landing?.heroImage,
    accentColor: cfg?.landing?.accentColor ?? "#000b63",
    headline: cfg?.landing?.headline?.en,
  }
})

// Search still needs the flat iso list (region cards only link out to /r/<code>/,
// they don't enumerate languages here). Only from listed regions — an
// unlisted region's languages shouldn't surface here either.
const seen = new Set<string>()
const allLanguages: Array<{
  iso: string
  name: string
  alt?: string
  regionId: string
  regionName: string
}> = []
for (const r of listedRegions) {
  for (const iso of r.available) {
    if (seen.has(iso)) continue
    seen.add(iso)
    allLanguages.push({ iso, name: displayName(iso), alt: altName(iso), regionId: r.id, regionName: r.displayName })
  }
}
allLanguages.sort((a, b) => a.name.localeCompare(b.name))
---

<BaseLayout title="Bibel Wiki" landing={true}>
  <section class="mb-8">
    <h1
      class="text-3xl sm:text-4xl font-bold tracking-tight"
      style="color:rgb(0,11,99);letter-spacing:-0.02em"
    >
      {t.app.selectLanguage}
    </h1>
  </section>

  <div class="mb-8">
    <LanguageSearch client:load languages={allLanguages} />
  </div>

  <div class="home-entry-grid">
    <a href="/eng" class="home-entry-card" style="--accent:#000b63">
      <span class="home-entry-name">English</span>
      <span class="home-entry-sub">Berean Standard Bible</span>
    </a>

    {regionCards.map((r) => (
      <a
        href={`/r/${r.id}/`}
        class={`home-entry-card${r.heroImage ? " has-image" : ""}`}
        style={`--accent:${r.accentColor}${r.heroImage ? `;--hero-image:url('${r.heroImage}')` : ""}`}
      >
        <span class="home-entry-count">{r.count}</span>
        <span class="home-entry-name">{r.displayName}</span>
        {r.headline && <span class="home-entry-sub">{r.headline}</span>}
      </a>
    ))}
  </div>

  <div class="home-browse-all">
    <button type="button" class="home-browse-all-btn" id="home-all-btn">
      🌐 {t.regionLanding.searchAll}
    </button>
  </div>

  <script is:inline>
    document.getElementById("home-all-btn")?.addEventListener("click", () => {
      window.dispatchEvent(new CustomEvent("open-language-picker"))
    })
  </script>
</BaseLayout>
