---
import BaseLayout from "../../layouts/BaseLayout.astro"
import Reader from "../../lib/reader/Reader.svelte"
import { ReaderLoader } from "../../components/ReaderLoader"
import { SearchIsland } from "../../components/search/SearchIsland"
import { BranchContentPane } from "../../components/nav/BranchContentPane"
import TemplateSelectorIsland from "../../components/TemplateSelectorIsland"
import { loadAllTemplates, loadLocaleData, loadAllLocaleData } from "../../lib/bw/template-utils"
import "../../styles/search.css"

// Stories landing (Simple mode): the template picker grid
const templates = loadAllTemplates()
const templateList = Object.values(templates).map((t) => {
  const allLocales = loadAllLocaleData(t.name)
  const localizedTitles: Record<string, string> = {}
  for (const [iso3, locale] of Object.entries(allLocales)) {
    if (locale.bookTitle) localizedTitles[iso3] = locale.bookTitle
  }
  return {
    name: t.name,
    image: t.image,
    engTitle: loadLocaleData(t.name, "eng")?.bookTitle || t.name,
    categoryCount: t.categories.length,
    storyCount: t.categories.reduce((sum, c) => sum + c.stories.length, 0),
    localizedTitles,
    imageConfig: t.imageConfig,
  }
})
---

<BaseLayout title="Bibel Wiki">
  <div id="pane-story-landing" class="max-w-4xl mx-auto" style="display:none">
    <TemplateSelectorIsland client:only="react" templates={templateList} />
  </div>
  <SearchIsland client:only="react" />
  <BranchContentPane client:only="react" />
  <div id="reader-root"></div>
  <ReaderLoader client:only="react" />
</BaseLayout>

<script>
  // ReaderLoader renders a #reader-mount div with data attributes.
  // Once it appears, mount the Svelte Reader.
  const root = document.getElementById("reader-root")!

  const observer = new MutationObserver(async () => {
    const mount = document.getElementById("reader-mount")
    if (!mount) return
    observer.disconnect()

    const { mount: svelteMount } = await import("svelte")
    const { default: Reader } = await import("../../lib/reader/Reader.svelte")

    root.innerHTML = ""
    svelteMount(Reader, {
      target: root,
      props: {
        iso: mount.dataset.iso!,
        docSetId: mount.dataset.docSetId!,
        pkfUrl: mount.dataset.pkfUrl!,
        catalogUrl: mount.dataset.catalogUrl!,
        styleUrl: mount.dataset.styleUrl || null,
        figureUrls: JSON.parse(mount.dataset.figureUrls || "{}"),
        captionMode: mount.dataset.captionMode || "hide",
        media: JSON.parse(mount.dataset.media || "{}"),
        bsbMode: mount.dataset.bsbMode === "true",
      },
    })
  })
  observer.observe(document.body, { childList: true, subtree: true })
</script>
