---
import BaseLayout from "../../../layouts/BaseLayout.astro"
import StoryReaderIsland from "../../../components/StoryReaderIsland"
import Door43StoryReaderIsland from "../../../components/Door43StoryReaderIsland"
import NavigationGridIsland from "../../../components/NavigationGridIsland"
import {
  loadAllTemplates,
  loadLocaleData,
  loadMarkdownContent,
  loadSceneBodyText,
  loadVideoManifest,
  loadAllLocaleData,
  findMissingStoryIds,
  extractStoryTestaments,
  getTemplateThemeCSS,
} from "../../../lib/bw/template-utils"
import prerenderIsos from "../../../../config/prerender-isos.json"

export function getStaticPaths() {
  const templates = loadAllTemplates()
  const paths: any[] = []
  const isos = prerenderIsos as string[]

  for (const [name, structure] of Object.entries(templates)) {
    const engLocale = loadLocaleData(name, "eng")
    const allLocales = loadAllLocaleData(name)
    const missingStoryIds = findMissingStoryIds(name)
    const storyTestaments = extractStoryTestaments(name)
    const themeCSS = getTemplateThemeCSS(name)

    const firstCatId = structure.categories[0]?.id

    // Template index (e.g. /eng/stories/OBS)
    for (const iso of isos) {
      paths.push({
        params: { iso, template: name, path: undefined },
        props: {
          pageType: "category" as const,
          templateName: name,
          structure,
          categoryId: firstCatId,
          engLocale,
          allLocales,
          missingStoryIds,
          storyTestaments,
          layoutTheme: structure.layoutTheme,
          themeCSS,
        },
      })
    }

    for (const cat of structure.categories) {
      for (const iso of isos) {
        paths.push({
          params: { iso, template: name, path: cat.id },
          props: {
            pageType: "category" as const,
            templateName: name,
            structure,
            categoryId: cat.id,
            engLocale,
            allLocales,
            missingStoryIds,
            storyTestaments,
            layoutTheme: structure.layoutTheme,
            themeCSS,
          },
        })
      }

      for (const story of cat.stories) {
        // door43-live templates (OBS-UW) have no local per-story content to
        // load at build time — see the "/l/[template]/" route's identical
        // comment for the full reasoning.
        if (structure.door43) {
          for (const iso of isos) {
            paths.push({
              params: { iso, template: name, path: `${cat.id}/${story.id}` },
              props: {
                pageType: "story" as const,
                templateName: name,
                categoryId: cat.id,
                storyId: story.id,
                engLocale,
                door43: structure.door43,
                allLocales,
                layoutTheme: structure.layoutTheme,
                imageConfig: structure.imageConfig,
                themeCSS,
              },
            })
          }
          continue
        }

        const markdownContent = loadMarkdownContent(name, cat.id, story.id) || ""
        const bodiesByLang: Record<string, Record<string, string>> = {}
        for (const iso of Object.keys(allLocales)) {
          const bodies = loadSceneBodyText(name, iso, story.id)
          if (Object.keys(bodies).length > 0) bodiesByLang[iso] = bodies
        }
        const sceneBodies = Object.keys(bodiesByLang).length > 0 ? bodiesByLang : null
        const videoLangs = loadVideoManifest(name, story.id, Object.keys(allLocales), structure.videoConfig)
        const videoByLang = Object.keys(videoLangs).length > 0 ? videoLangs : null
        for (const iso of isos) {
          paths.push({
            params: { iso, template: name, path: `${cat.id}/${story.id}` },
            props: {
              pageType: "story" as const,
              templateName: name,
              categoryId: cat.id,
              storyId: story.id,
              engLocale,
              markdownContent,
              sceneBodies,
              videoByLang,
              allLocales,
              layoutTheme: structure.layoutTheme,
              imageConfig: structure.imageConfig,
              themeCSS,
            },
          })
        }
      }
    }
  }

  return paths
}

const { iso } = Astro.params
const props = Astro.props
const pageTitle = props.engLocale?.bookTitle || props.templateName
---

<BaseLayout title={`${pageTitle} — Bibel Wiki`} pageType={props.pageType} themeCSS={props.themeCSS}>
  {props.pageType === "category" ? (
    <div class="max-w-4xl mx-auto p-4">
      <NavigationGridIsland
        client:load
        templateName={props.templateName}
        structure={props.structure}
        engLocale={props.engLocale}
        allLocales={props.allLocales}
        defaultCategoryId={props.categoryId}
        missingStoryIds={props.missingStoryIds}
        storyTestaments={props.storyTestaments}
        imageConfig={props.structure.imageConfig}
      />
    </div>
  ) : props.door43 ? (
    <div class="max-w-3xl mx-auto p-4">
      <Door43StoryReaderIsland
        client:only="react"
        templateName={props.templateName}
        storyId={props.storyId}
        engLocale={props.engLocale}
      />
    </div>
  ) : (
    <div class="max-w-3xl mx-auto p-4">
      <StoryReaderIsland
        client:only="react"
        templateName={props.templateName}
        categoryId={props.categoryId}
        storyId={props.storyId}
        engLocale={props.engLocale}
        markdownContent={props.markdownContent}
        sceneBodies={props.sceneBodies}
        videoByLang={props.videoByLang}
        allLocales={props.allLocales}
        imageConfig={props.imageConfig}
      />
    </div>
  )}
</BaseLayout>
