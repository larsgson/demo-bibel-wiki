---
import "../styles/global.css"
import "../styles/sidebar.css"
import MenuButton from "../components/nav/MenuButton.astro"
import { AppSidebar } from "../components/nav/AppSidebar"
import { StandardSidebar } from "../components/nav/StandardSidebar"
import { BiblePickerSheet } from "../components/BiblePickerSheet"
import { StandardBottomBar } from "../components/nav/StandardBottomBar"
import LanguageButton from "../components/LanguageButton"
import { loadAllTemplates, loadLocaleData } from "../lib/bw/template-utils"
import type { SidebarTreeNode, BibleBookEntry } from "../components/nav/AppSidebar"
import books from "../lib/bw/bible-books"

interface Props {
  title?: string
  /** Landing pages hide the left navigation entirely (no sidebar / menu). */
  landing?: boolean
  /** Region hero photo credit (config/regions/<code>.toml `landing.heroCredit`),
   *  appended to the footer's attribution line — a region landing page's only
   *  extra provenance need, so it doesn't warrant its own footer variant. */
  heroCredit?: { text: string; url: string }
  /** Set by [iso]/[template]/[...path].astro. On mobile in Simple mode (UI
   *  level 1) the site header docks to the bottom of the screen as an app
   *  bar — appropriate while browsing stories, but it sits on top of actual
   *  story content once you're reading one. "story" hides it there; plain
   *  navigation (back out to the category grid) is a full page load, so it
   *  reappears on its own, no client-side state to reset. */
  pageType?: "story" | "category"
}

const { title = "Bibel Wiki", landing = false, heroCredit, pageType } = Astro.props

// Build story tree for the sidebar (Templates → Categories → Stories)
const templates = loadAllTemplates()
const storyTree: SidebarTreeNode[] = Object.entries(templates).map(([name, structure]) => {
  const eng = loadLocaleData(name, "eng")
  const spa = loadLocaleData(name, "spa")
  return {
    id: name,
    label: { en: eng?.bookTitle ?? name, es: spa?.bookTitle ?? eng?.bookTitle ?? name },
    children: structure.categories.map((cat) => ({
      id: `${name}/${cat.id}`,
      label: {
        en: eng?.categories[cat.id]?.title ?? `Category ${cat.id}`,
        es: spa?.categories[cat.id]?.title ?? eng?.categories[cat.id]?.title ?? `Categoría ${cat.id}`,
      },
      href: `/${name}/${cat.id}`,
      children: cat.stories.map((s) => {
        const storyKey = `${cat.id}.${s.id}`
        return {
          id: `${name}/${cat.id}/${s.id}`,
          label: {
            en: eng?.stories[storyKey]?.title ?? `Story ${s.id}`,
            es: spa?.stories[storyKey]?.title ?? eng?.stories[storyKey]?.title ?? `Historia ${s.id}`,
          },
          href: `/${name}/${cat.id}/${s.id}`,
        }
      }),
    })),
  }
})

// Bible books for sidebar navigation (compact: code + names + chapter count)
const esBookNames: Record<string, string> = {
  GEN: "Génesis", EXO: "Éxodo", LEV: "Levítico", NUM: "Números", DEU: "Deuteronomio",
  JOS: "Josué", JDG: "Jueces", RUT: "Rut", "1SA": "1 Samuel", "2SA": "2 Samuel",
  "1KI": "1 Reyes", "2KI": "2 Reyes", "1CH": "1 Crónicas", "2CH": "2 Crónicas",
  EZR: "Esdras", NEH: "Nehemías", EST: "Ester", JOB: "Job", PSA: "Salmos",
  PRO: "Proverbios", ECC: "Eclesiastés", SNG: "Cantares", ISA: "Isaías", JER: "Jeremías",
  LAM: "Lamentaciones", EZK: "Ezequiel", DAN: "Daniel", HOS: "Oseas", JOL: "Joel",
  AMO: "Amós", OBA: "Abdías", JON: "Jonás", MIC: "Miqueas", NAM: "Nahúm",
  HAB: "Habacuc", ZEP: "Sofonías", HAG: "Hageo", ZEC: "Zacarías", MAL: "Malaquías",
  MAT: "Mateo", MRK: "Marcos", LUK: "Lucas", JHN: "Juan", ACT: "Hechos",
  ROM: "Romanos", "1CO": "1 Corintios", "2CO": "2 Corintios", GAL: "Gálatas",
  EPH: "Efesios", PHP: "Filipenses", COL: "Colosenses", "1TH": "1 Tesalonicenses",
  "2TH": "2 Tesalonicenses", "1TI": "1 Timoteo", "2TI": "2 Timoteo", TIT: "Tito",
  PHM: "Filemón", HEB: "Hebreos", JAS: "Santiago", "1PE": "1 Pedro", "2PE": "2 Pedro",
  "1JN": "1 Juan", "2JN": "2 Juan", "3JN": "3 Juan", JUD: "Judas", REV: "Apocalipsis",
}
const bibleBooks: BibleBookEntry[] = books.map((b) => ({
  code: b.code,
  name: b.name,
  nameEs: esBookNames[b.code] ?? b.name,
  chapters: b.chapters,
  ot: b.id <= 39,
}))
---

<!doctype html>
<html lang="en" data-page-type={pageType}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <title>{title}</title>
    <script is:inline>
      // Set the UI level on <html> before first paint so the Simple-mode
      // "no left navigation" CSS applies without a flash of the sidebar.
      try {
        var lvl = localStorage.getItem("bw-ui-level") || "1";
        document.documentElement.dataset.uiLevel = lvl;
      } catch (e) { document.documentElement.dataset.uiLevel = "1"; }
    </script>
  </head>
  <body class="min-h-screen bg-[#fbfaf6] text-brand">
    {!landing && <MenuButton />}
    {!landing && <AppSidebar client:only="react" storyTree={storyTree} bibleBooks={bibleBooks} />}
    {!landing && <StandardSidebar client:only="react" />}
    {!landing && <BiblePickerSheet client:only="react" />}
    {!landing && <StandardBottomBar client:only="react" />}

    <div class={`app-main min-h-screen flex flex-col${landing ? " app-main--landing" : ""}`}>
    <header
      class="site-header sticky top-0 z-10 border-b"
      style="background:rgb(0,11,99);border-color:rgba(0,11,99,0.4)"
    >
      <div id="header-bar" class="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between gap-3">
        <a href="/" id="header-title" class="text-white font-semibold tracking-tight text-lg" style="display:none"></a>
        <div class="flex items-center gap-2">
          <LanguageButton client:only="react" />
          <div class="ui-level-wrapper" id="ui-level-wrapper">
            <button class="ui-level-gear" id="ui-level-btn" type="button" aria-label="Interface level">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="3"/>
                <path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 01-2.83 2.83l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"/>
              </svg>
              <span class="ui-level-badge" id="ui-level-badge"></span>
            </button>
            <div class="ui-level-popover" id="ui-level-popover">
              <button class="ui-level-option" data-level="1" type="button">
                <span class="ui-level-dots"><span class="dot filled"></span><span class="dot"></span><span class="dot"></span></span>
                <span class="ui-level-label" data-en="Simple" data-es="Básico"></span>
              </button>
              <button class="ui-level-option" data-level="2" type="button">
                <span class="ui-level-dots"><span class="dot filled"></span><span class="dot filled"></span><span class="dot"></span></span>
                <span class="ui-level-label" data-en="Standard" data-es="Estándar"></span>
              </button>
              <button class="ui-level-option" data-level="3" type="button">
                <span class="ui-level-dots"><span class="dot filled"></span><span class="dot filled"></span><span class="dot filled"></span></span>
                <span class="ui-level-label" data-en="Study" data-es="Estudiar"></span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </header>

    <main class="flex-1 px-4 pb-6 sm:pb-10 max-w-5xl w-full mx-auto">
      <slot />
    </main>

    <footer
      class="text-xs px-4 py-3 border-t"
      style="color:rgba(0,11,99,0.55);border-color:rgba(0,11,99,0.12);background:rgba(255,255,255,0.4)"
    >
      <div class="max-w-5xl mx-auto">
        Data from scriptureearth.org · CC BY-NC-ND 4.0 for included languages (see config/licenses.json).
        {heroCredit && (
          <>
            {" "}· <a href={heroCredit.url} target="_blank" rel="noopener noreferrer nofollow" style="color:inherit;text-decoration:underline">{heroCredit.text}</a>
          </>
        )}
      </div>
    </footer>
    </div>

    <!-- Focus panel (modal playing overlay) -->
    <div class="focus-panel-backdrop" id="focus-backdrop" style="display:none"></div>
    <div class="focus-panel" id="focus-panel" style="display:none">
      <div class="focus-panel-content" id="focus-panel-content"></div>
      <div class="focus-panel-controls" id="focus-panel-controls">
        <button class="focus-panel-btn" id="focus-play-btn" aria-label="Play">
          <svg id="fp-icon-play" width="48" height="48" viewBox="0 0 24 24" fill="currentColor">
            <path d="M8 5v14l11-7z"/>
          </svg>
          <svg id="fp-icon-pause" width="48" height="48" viewBox="0 0 24 24" fill="currentColor" style="display:none">
            <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
          </svg>
        </button>
        <button class="focus-panel-btn focus-panel-stop" id="focus-stop-btn" aria-label="Stop" style="display:none">
          <svg width="36" height="36" viewBox="0 0 24 24" fill="currentColor">
            <path d="M6 6h12v12H6z"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Audio toast notification -->
    <div class="audio-toast" id="audio-toast" style="display:none"></div>

    <!-- Mini player (floating bottom-right) -->
    <div class="listen-player" id="listen-player" style="display:none">
      <div class="listen-player-image" id="player-image"></div>
      <div class="listen-player-overlay">
        <div class="listen-player-content">
          <button class="listen-player-btn" id="player-btn" aria-label="Play">
            <svg id="player-icon-play" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d="M8 5v14l11-7z"/>
            </svg>
            <svg id="player-icon-pause" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" style="display:none">
              <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
            </svg>
          </button>
        </div>
      </div>
      <button class="listen-player-close" id="player-close" aria-label="Stop" style="display:none">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
        </svg>
      </button>
      <div class="listen-player-pulse" id="player-pulse" style="display:none"></div>
    </div>

    <!-- Confirm dialog (singleton — see src/lib/bw/confirm-dialog.ts) -->
    <dialog class="confirm-dialog" id="confirm-dialog">
      <p class="confirm-dialog-message" id="confirm-dialog-message"></p>
      <div class="confirm-dialog-actions">
        <button type="button" class="confirm-dialog-btn confirm-dialog-cancel" id="confirm-dialog-cancel"></button>
        <button type="button" class="confirm-dialog-btn confirm-dialog-continue" id="confirm-dialog-continue"></button>
      </div>
    </dialog>

    <script>
      import { initIsoFromUrl } from "../stores/iso-store"
      import { initApiConfig } from "../stores/api-store"
      import { initSearchMode } from "../stores/search-store"
      import { $uiLevel, requestUILevel, type UILevel } from "../stores/ui-level-store"
      import {
        $audioPlayState,
        $isPlaying,
        $playerVisible,
        $focusMode,
        $pausedState,
        $currentVerseIdx,
        $currentVerseEntries,
        $audioContext,
        $audioPageStory,
        $playerCardInfo,
        playVerse,
        pausePlayback,
        resumePlayback,
        stopAll,
        unlockAudio,
        $audioToast,
      } from "../stores/audio-store"
      import { t } from "../lib/bw/ui-locales"

      import { $selectedIso } from "../stores/iso-store"
      import { $activeRegion } from "../stores/region-store"
      import { regionConfigByCode, uiLangForRegion } from "../lib/data/region-config"

      initIsoFromUrl()
      initApiConfig()
      initSearchMode()

      // UI level gear + popover
      const levelBtn = document.getElementById("ui-level-btn")!
      const levelPopover = document.getElementById("ui-level-popover")!
      const levelBadge = document.getElementById("ui-level-badge")!
      const levelOptions = levelPopover.querySelectorAll<HTMLButtonElement>(".ui-level-option")

      function renderBadge(level: UILevel) {
        levelBadge.textContent = "●".repeat(level) + "○".repeat(3 - level)
        levelOptions.forEach((opt) => {
          opt.classList.toggle("active", opt.dataset.level === String(level))
        })
        document.documentElement.dataset.uiLevel = String(level)
      }
      renderBadge($uiLevel.get())

      // Only en/es data-* attrs exist on .ui-level-label below, so this stays
      // a binary fallback for that one legacy widget — not a general-purpose
      // UI-language resolver (that's uiLangForRegion, used just below for
      // the header title, which needs to reflect the REGION's own language,
      // not whatever scripture the visitor happens to be reading).
      const uiLang = $selectedIso.get() === "eng" ? "en" : "es"

      // Header title: region TOML title if a region is active, otherwise "Bibel Wiki".
      // Always rendered in the region's own uiLanguage (config/regions/<code>.toml),
      // regardless of which language the visitor is currently reading in.
      const headerTitleEl = document.getElementById("header-title")
      if (headerTitleEl) {
        const activeRegion = $activeRegion.get()
        const cfg = activeRegion ? regionConfigByCode.get(activeRegion) : null
        const regionLang = uiLangForRegion(activeRegion)
        const title = cfg?.title?.[regionLang] ?? cfg?.title?.en ?? "Bibel Wiki"
        headerTitleEl.textContent = title
        headerTitleEl.style.display = ""
      }
      levelPopover.querySelectorAll<HTMLElement>(".ui-level-label").forEach((el) => {
        el.textContent = el.dataset[uiLang] ?? el.dataset.en ?? ""
      })

      levelBtn.addEventListener("click", (e) => {
        e.stopPropagation()
        const open = levelPopover.classList.toggle("open")
        if (open) {
          const close = (ev: Event) => {
            if (!levelPopover.contains(ev.target as Node)) {
              levelPopover.classList.remove("open")
              document.removeEventListener("click", close)
            }
          }
          setTimeout(() => document.addEventListener("click", close), 0)
        }
      })

      levelOptions.forEach((opt) => {
        opt.addEventListener("click", async () => {
          const level = Number(opt.dataset.level) as UILevel
          const regionLang = uiLangForRegion($activeRegion.get())
          // $uiLevel.subscribe (below) re-renders the badge on an actual
          // switch; nothing to do here if the visitor cancelled.
          await requestUILevel(level, t(regionLang, "nav.confirmSimpleMode"), {
            cancel: t(regionLang, "nav.cancel"),
            continueAction: t(regionLang, "nav.continueAction"),
          })
          levelPopover.classList.remove("open")
        })
      })

      $uiLevel.subscribe((level: UILevel) => renderBadge(level))

      // Story landing pane (Simple mode): a plain div that can't self-hide like
      // the React/Svelte islands, so toggle it from here on pane changes.
      const storyLanding = document.getElementById("pane-story-landing")
      if (storyLanding) {
        const syncStoryLanding = (pane: string) => {
          storyLanding.style.display = pane === "story" ? "" : "none"
        }
        const initialPane = $uiLevel.get() === 1 ? "story" : "bible"
        syncStoryLanding(initialPane)
        window.addEventListener("pane-changed", ((e: CustomEvent) => {
          syncStoryLanding(e.detail?.pane || "story")
        }) as EventListener)
      }

      function updateIsoLinks(iso: string) {
        document.querySelectorAll<HTMLAnchorElement>("[data-iso-link]").forEach((a) => {
          a.href = `/${iso}/${a.dataset.isoLink}`
        })
      }
      updateIsoLinks($selectedIso.get())
      $selectedIso.subscribe(updateIsoLinks)

      // iOS audio unlock on first interaction
      const unlockEvents = ["touchstart", "click"] as const
      function onFirstInteraction() {
        unlockAudio()
        for (const evt of unlockEvents) {
          document.removeEventListener(evt, onFirstInteraction, true)
        }
      }
      for (const evt of unlockEvents) {
        document.addEventListener(evt, onFirstInteraction, true)
      }

      function initAudioUI() {
        const focusBackdrop = document.getElementById("focus-backdrop")!
        const focusPanel = document.getElementById("focus-panel")!
        const focusPanelContent = document.getElementById("focus-panel-content")!
        const focusPanelControls = document.getElementById("focus-panel-controls")!
        const focusPlayBtn = document.getElementById("focus-play-btn")!
        const focusStopBtn = document.getElementById("focus-stop-btn")!
        const fpIconPlay = document.getElementById("fp-icon-play")!
        const fpIconPause = document.getElementById("fp-icon-pause")!

        const playerEl = document.getElementById("listen-player")!
        const playerImage = document.getElementById("player-image")!
        const playerBtn = document.getElementById("player-btn")!
        const playerClose = document.getElementById("player-close")!
        const playerPulse = document.getElementById("player-pulse")!
        const playerIconPlay = document.getElementById("player-icon-play")!
        const playerIconPause = document.getElementById("player-icon-pause")!

        function populateFocusPanel(idx: number) {
          const el = document.getElementById(`verse-${idx}`)
          focusPanelContent.innerHTML = ""
          if (el) {
            const clone = el.cloneNode(true) as HTMLElement
            clone.removeAttribute("id")
            clone.removeAttribute("data-verse-idx")
            clone.removeAttribute("data-clickable")
            clone.style.cursor = "default"
            clone.classList.remove("verse-focus-active")
            focusPanelContent.appendChild(clone)
            applyKenBurnsToImages()
          }
          focusPanel.scrollTop = 0
        }

        let lastKenBurnsVariant = 0
        function applyKenBurnsToImages() {
          const images = focusPanelContent.querySelectorAll(".listen-verse-images img")
          if (!images.length) return
          const entries = $currentVerseEntries.get()
          const idx = $currentVerseIdx.get()
          const entry = entries[idx]
          const duration = entry ? Math.max(entry.endTime - entry.startTime, 5) : 10
          const perImage = duration / images.length
          images.forEach((img) => {
            let variant = Math.floor(Math.random() * 4) + 1
            if (variant === lastKenBurnsVariant) variant = (variant % 4) + 1
            lastKenBurnsVariant = variant
            img.classList.add(`ken-burns-${variant}`)
            ;(img as HTMLElement).style.animation = `kenBurns${variant} ${perImage}s linear forwards`
          })
        }

        function showFocusPanel(idx: number) {
          populateFocusPanel(idx)
          focusBackdrop.style.display = ""
          focusPanel.style.display = ""
        }

        function hideFocusPanel() {
          focusBackdrop.style.display = "none"
          focusPanel.style.display = "none"
          focusPanelContent.innerHTML = ""
        }

        function isOnAudioPage() {
          const audioStory = $audioPageStory.get()
          if (!audioStory) return false
          const parts = window.location.pathname.split("/").filter(Boolean)
          let pagePath: string
          if (/^[a-z]{3}$/.test(parts[0] || "")) pagePath = parts.slice(1).join("/")
          else pagePath = parts.join("/")
          return pagePath === audioStory
        }

        function syncHighlight() {
          document.querySelectorAll(".verse-focus-active").forEach((el) =>
            el.classList.remove("verse-focus-active"),
          )
          const isActive = $audioPlayState.get() !== "idle" || !!$pausedState.get()
          if (!isActive || !isOnAudioPage()) return
          const entries = $currentVerseEntries.get()
          const idx = $currentVerseIdx.get()
          const sectionIdx = entries[idx]?.sectionIndex ?? idx
          const card = document.getElementById(`verse-${sectionIdx}`)
          if (card) card.classList.add("verse-focus-active")
        }

        function scrollToVerse(idx: number) {
          const card = document.getElementById(`verse-${idx}`)
          if (!card) return
          const cardRect = card.getBoundingClientRect()
          const viewportCenter = window.innerHeight / 2
          const cardCenter = cardRect.top + cardRect.height / 2
          const delta = cardCenter - viewportCenter
          window.scrollBy({ top: delta, behavior: "smooth" })
        }

        $focusMode.subscribe((active: boolean) => {
          if (active) {
            document.body.classList.add("focus-mode")
            playerEl.style.display = "none"
            const idx = $currentVerseIdx.get()
            requestAnimationFrame(() => scrollToVerse(idx))
            showFocusPanel(idx)
          } else {
            document.body.classList.remove("focus-mode")
            hideFocusPanel()
            if ($playerVisible.get()) playerEl.style.display = ""
          }
          syncHighlight()
        })

        $playerVisible.subscribe((visible: boolean) => {
          if ($focusMode.get()) { playerEl.style.display = "none" }
          else { playerEl.style.display = visible ? "" : "none" }
          if (!visible) playerImage.innerHTML = ""
        })

        $isPlaying.subscribe((playing: boolean) => {
          fpIconPlay.style.display = playing ? "none" : ""
          fpIconPause.style.display = playing ? "" : "none"
          focusStopBtn.style.display = playing ? "none" : ""
          focusPanelControls.classList.toggle("is-playing", playing)
          playerIconPlay.style.display = playing ? "none" : ""
          playerIconPause.style.display = playing ? "" : "none"
          playerPulse.style.display = playing ? "" : "none"
          playerClose.style.display = playing ? "none" : ""
          document.body.classList.toggle("audio-paused", !playing)
          syncHighlight()
        })

        $currentVerseIdx.subscribe((idx: number) => {
          syncHighlight()
          if ($audioPlayState.get() === "idle" && !$pausedState.get()) return
          const entries = $currentVerseEntries.get()
          const sectionIdx = entries[idx]?.sectionIndex ?? idx
          if ($focusMode.get()) {
            populateFocusPanel(sectionIdx)
            scrollToVerse(sectionIdx)
          }
        })

        $playerCardInfo.subscribe(({ title, imageUrl }) => {
          if (imageUrl) playerImage.innerHTML = `<img src="${imageUrl}" alt="${title}">`
        })

        const toastEl = document.getElementById("audio-toast")!
        let toastTimer: ReturnType<typeof setTimeout> | null = null
        $audioToast.subscribe((key: string) => {
          if (!key) { toastEl.style.display = "none"; return }
          const langCode = window.location.pathname.split("/").filter(Boolean)[0] || "en"
          toastEl.textContent = t(langCode, `audioPlayer.${key}`)
          toastEl.style.display = "block"
          if (toastTimer) clearTimeout(toastTimer)
          toastTimer = setTimeout(() => $audioToast.set(""), 4000)
        })

        function togglePlayPause() {
          if ($audioPlayState.get() === "idle") {
            if ($pausedState.get()) resumePlayback()
            else playVerse($currentVerseIdx.get())
          } else {
            pausePlayback()
          }
          unlockAudio()
        }

        focusPlayBtn.addEventListener("click", (e) => { e.stopPropagation(); togglePlayPause() })
        focusStopBtn.addEventListener("click", (e) => { e.stopPropagation(); stopAll() })
        focusBackdrop.addEventListener("click", () => $focusMode.set(false))

        playerEl.addEventListener("click", () => $focusMode.set(true))
        playerBtn.addEventListener("click", (e) => { e.stopPropagation(); togglePlayPause() })
        playerClose.addEventListener("click", (e) => { e.stopPropagation(); stopAll() })

        window.addEventListener("wheel", () => { if ($focusMode.get()) $focusMode.set(false) })
        window.addEventListener("touchmove", () => { if ($focusMode.get()) $focusMode.set(false) })

        window.addEventListener("focus-panel-refresh", ((e: CustomEvent) => {
          if (!$focusMode.get()) return
          const idx = e.detail?.idx ?? $currentVerseIdx.get()
          document.body.classList.add("focus-mode")
          playerEl.style.display = "none"
          requestAnimationFrame(() => scrollToVerse(idx))
          showFocusPanel(idx)
        }) as EventListener)
      }

      if (!(window as any).__audioUIInitialized) {
        ;(window as any).__audioUIInitialized = true
        initAudioUI()
      }
    </script>
  </body>
</html>

