# API backend (bcv-query)
PUBLIC_API_BASE_URL=https://bcv-query.qombi.com
PUBLIC_API_PASSWORD=

# Original-language (Hebrew/Greek) interlinear backend for the parallel view.
# Unset: the parallel view shows no original-text panel content.
PUBLIC_SHORESH_API_URL=https://shoresh.qombi.com/interlinear

# Data fetching
DATA_REPO=larsgson/se-regional-data
# DATA_RELEASE_TAG=latest
# SKIP_DATA_FETCH=1

# External .pkf hosting (Cloudflare R2). When set, the browser fetches .pkf
# data/info/timing/catalog from this host instead of the local /pkf path —
# keeps the ~1.5 GB out of the Netlify deploy and lets local dev skip the big
# data download. Leave unset to serve from the in-deploy /pkf. No trailing slash.
# PUBLIC_PKF_BASE_URL=https://cdn.bibel.wiki
